{
  "format_version": "1.8.0",
  "animations": {
    "animation.hand_demon.idle": {
      "loop": true,
      "animation_length": 2,
      "bones": {
        "body": {
          "position": {
            "vector": [0, "math.sin(query.anim_time * 180) * 0.5", 0]
          }
        }
      }
    },
    "animation.hand_demon.walk": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "left_arm": {
          "rotation": ["math.cos(query.anim_time * 360) * 25", 0, 0]
        },
        "right_arm": {
          "rotation": ["math.cos(query.anim_time * 360) * -25", 0, 0]
        }
      }
    }
  }
}