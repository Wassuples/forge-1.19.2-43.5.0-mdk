            level.sendParticles(ParticleTypes.BUBBLE, point.x, point.y, point.z, 1, 0, 0, 0, 0);
        }
    }

    public static void spawnSlashParticles(ServerPlayer player, ParticleOptions particle) {
        ServerLevel level = player.getLevel();
        Vec3 eyePos = player.getEyePosition();
        int particleCount = 30;
        double radius = 2.0;
        double arcDegrees = 140.0;
        float playerYaw = -player.getYRot() * ((float) Math.PI / 180F);
        float playerPitch = player.getXRot() * ((float) Math.PI / 180F);
        for (int i = 0; i < particleCount; i++) {
            double angle = Math.toRadians((180.0 - arcDegrees) / 2 + (arcDegrees / (particleCount - 1)) * i);
            Vec3 particlePos = new Vec3(Math.cos(angle), 0, Math.sin(angle)).scale(radius);
            particlePos = particlePos.xRot(-playerPitch);
            particlePos = particlePos.yRot(-playerYaw);
            level.sendParticles(particle,
                    eyePos.x + particlePos.x,
                    eyePos.y + particlePos.y,
                    eyePos.z + particlePos.z,
                    1, 0.0D, 0.0D, 0.0D, 0.0D);
        }
    }

    public static void spawnSlashParticlesInDirection(ServerPlayer player, Vec3 direction, ParticleOptions particle) {
        ServerLevel level = player.getLevel();
        Vec3 eyePos = player.getEyePosition();
        int particleCount = 30;
        double radius = 2.0;
        double arcDegrees = 140.0;
        float yaw = (float) (net.minecraft.util.Mth.atan2(direction.z, direction.x) * (180D / Math.PI)) - 90.0F;
        float pitch = (float) (-(net.minecraft.util.Mth.atan2(direction.y, direction.horizontalDistance()) * (180D / Math.PI)));
        float playerYawRad = -yaw * ((float) Math.PI / 180F);
        float playerPitchRad = pitch * ((float) Math.PI / 180F);
        for (int i = 0; i < particleCount; i++) {
            double angle = Math.toRadians((180.0 - arcDegrees) / 2 + (arcDegrees / (particleCount - 1)) * i);
            Vec3 particlePos = new Vec3(Math.cos(angle), 0, Math.sin(angle)).scale(radius);
            particlePos = particlePos.xRot(-playerPitchRad);
            particlePos = particlePos.yRot(-playerYawRad);
            level.sendParticles(particle,
                    eyePos.x + particlePos.x,
                    eyePos.y + particlePos.y,
                    eyePos.z + particlePos.z,
                    1, 0.0D, 0.0D, 0.0D, 0.0D);
        }
    }

    public static void spawnConstantFluxDragon(ServerPlayer player, int activeTicks) {
