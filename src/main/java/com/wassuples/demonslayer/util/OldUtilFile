    public static void spawnRengokuDragon(ServerPlayer player, int activeTicks, int chargeTicks) {
        ServerLevel level = player.getLevel();
        float progress = (float) activeTicks / chargeTicks;
        int particleCount = (int) (10 + 90 * progress); // From 10 to 100 particles based on charge

        DustParticleOptions redDust = new DustParticleOptions(new Vector3f(1.0f, 0.2f, 0.1f), 1.0f);
        DustParticleOptions yellowDust = new DustParticleOptions(new Vector3f(1.0f, 0.9f, 0.2f), 1.2f);

        for (int i = 0; i < particleCount; i++) {
            double angle = (player.tickCount * 0.1) + (i * 0.2 * (1 - progress)); // Coils tighter as charge completes
            double radius = 1.0 + (1.5 * progress); // Dragon forms further out as it solidifies
            double xOffset = Math.cos(angle) * radius;
            double zOffset = Math.sin(angle) * radius;
            double yOffset = i * (0.05 * progress); // Coils upwards

            level.sendParticles(i % 2 == 0 ? redDust : yellowDust,
                    player.getX() + xOffset,
                    player.getY() + yOffset,
                    player.getZ() + zOffset, 1, 0, 0, 0, 0);
        }

        if (progress > 0.5) {
            Vec3 lookVec = player.getLookAngle();
            Vec3 headPos = player.getEyePosition().add(lookVec.scale(1.5));
            level.sendParticles(ParticleTypes.LAVA, headPos.x, headPos.y, headPos.z, (int) (10 * progress), 0.1, 0.1, 0.1, 0);
        }
    }

