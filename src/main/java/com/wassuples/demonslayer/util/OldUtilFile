        for (LivingEntity target : targets) {
            target.hurt(DamageSource.playerAttack(player), damage);
            target.setSecondsOnFire(10); // SET THEM ABLAZE!!
        }


    }

    public static void dealClawDamage(ServerPlayer player, ServerLevel level, float damage) {
        Vec3 arcOrigin = player.getEyePosition();

        // --- THE FIX ---
        // 1. Get player's horizontal rotation (Yaw) in radians.
        float yawRad = -player.getYRot() * ((float) Math.PI / 180F);
        // 2. Calculate a 2D direction vector directly from the yaw.
        // This is mathematically robust and cannot fail when looking down.
        Vec3 horizontalDir = new Vec3(Math.sin(yawRad), 0, Math.cos(yawRad)).normalize();

        for (int clawIndex = 0; clawIndex < 4; clawIndex++) {
            double angleOffset = -45.0 + (clawIndex * 30.0);
            Vec3 slashDirection = horizontalDir.yRot((float) Math.toRadians(angleOffset));

            BlockPos endGroundPos = level.getHeightmapPos(net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING_NO_LEAVES,
                    player.blockPosition().offset(slashDirection.scale(6).x, 0, slashDirection.scale(6).z));
            Vec3 arcEnd = Vec3.atBottomCenterOf(endGroundPos);

            for (int i = 0; i <= 15; i++) {
                double progress = i / 15.0;
                Vec3 linePoint = arcOrigin.lerp(arcEnd, progress);
                double arcHeight = Math.sin(progress * Math.PI) * 3.0;
                Vec3 currentPoint = linePoint.add(0, arcHeight, 0);

                AABB damageBox = new AABB(currentPoint, currentPoint).inflate(1.8);
                List<LivingEntity> targets = level.getEntitiesOfClass(LivingEntity.class, damageBox, entity ->
                        entity != player && entity.isAlive());

                for (LivingEntity target : targets) {
                    if (target.hurt(DamageSource.playerAttack(player), damage)) {
                        Vec3 knockbackDir = new Vec3(target.getX() - player.getX(), 0.5, target.getZ() - player.getZ()).normalize();
                        target.push(knockbackDir.x * 0.7, knockbackDir.y * 0.4, knockbackDir.z * 0.7);
                    }
                }
            }
        }
    }

    public static void spawnThrustLineParticles(ServerPlayer player, ServerLevel level, double range) {
        Vec3 start = player.getEyePosition(1.0f);
