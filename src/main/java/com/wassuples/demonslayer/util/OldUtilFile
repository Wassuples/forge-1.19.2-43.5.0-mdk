public class FormUtils {
    public static boolean isParryable(DamageSource source) {
        if (source.isProjectile() || source.getDirectEntity() instanceof LivingEntity) {
            return !source.isExplosion() && !source.isFire() && !source.isMagic()
                    && !source.isBypassInvul() && !source.isCreativePlayer();
        }
        return false;
    }

    public static void applyKnockbackImmunity(ServerPlayer player) {
        AttributeInstance attribute = player.getAttribute(Attributes.KNOCKBACK_RESISTANCE);
        if (attribute != null) {
            attribute.removeModifier(FormTickHandler.KNOCKBACK_IMMUNITY_UUID);
            AttributeModifier modifier = new AttributeModifier(FormTickHandler.KNOCKBACK_IMMUNITY_UUID, "Form knockback immunity", 1.0D, AttributeModifier.Operation.ADDITION);
            attribute.addPermanentModifier(modifier);
        }
    }

    public static void removeKnockbackImmunity(ServerPlayer player) {
        AttributeInstance attribute = player.getAttribute(Attributes.KNOCKBACK_RESISTANCE);
        if (attribute != null) {
            attribute.removeModifier(FormTickHandler.KNOCKBACK_IMMUNITY_UUID);
        }
    }

    public static void dealDirectionalDamage(ServerPlayer player, ServerLevel level, double range, float damage, double angleThreshold) {
        Vec3 lookVec = player.getLookAngle().normalize();
        AABB attackAABB = player.getBoundingBox().inflate(range, range, range);
        List<LivingEntity> targets = level.getEntitiesOfClass(LivingEntity.class, attackAABB, entity ->
                entity != player && entity.isAlive() && player.hasLineOfSight(entity));
        for (LivingEntity target : targets) {
            Vec3 toTarget = target.position().subtract(player.position()).normalize();
            double dot = lookVec.dot(toTarget);
            if (dot > angleThreshold) {
                target.hurt(DamageSource.playerAttack(player), damage);
                Vec3 knockback = toTarget.scale(0.5);
                target.push(knockback.x, 0.1, knockback.z);
            }
        }
    }

    public static void dealAOEDamage(ServerPlayer player, ServerLevel level, double range, float damage, float knockbackStrength) {
        AABB attackAABB = player.getBoundingBox().inflate(range, range, range);
        List<LivingEntity> targets = level.getEntitiesOfClass(LivingEntity.class, attackAABB, entity ->
                entity != player && entity.isAlive());
        for (LivingEntity target : targets) {
            target.hurt(DamageSource.playerAttack(player), damage);
            double d0 = player.getX() - target.getX();
            double d1;
            for (d1 = player.getZ() - target.getZ(); d0 * d0 + d1 * d1 < 1.0E-4D; d1 = (Math.random() - Math.random()) * 0.01D) {
                d0 = (Math.random() - Math.random()) * 0.01D;
            }
            target.knockback(knockbackStrength, d0, d1);
        }
    }

    public static void dealThrustDamage(ServerPlayer player, ServerLevel level, double range, float damage) {
        Vec3 start = player.position().add(0, player.getEyeHeight(), 0);
        Vec3 direction = player.getLookAngle().normalize();
        Vec3 end = start.add(direction.scale(range));
        AABB lineAABB = new AABB(start, end).inflate(1.0);
        List<LivingEntity> targets = level.getEntitiesOfClass(LivingEntity.class, lineAABB, entity ->
                entity != player && entity.isAlive());
        for (LivingEntity target : targets) {
            Vec3 targetPos = target.getBoundingBox().getCenter();
            Vec3 toTarget = targetPos.subtract(start);
            double projection = toTarget.dot(direction);
            if (projection >= 0 && projection <= range) {
                Vec3 closestPointOnLine = start.add(direction.scale(projection));
                double distanceToLine = targetPos.distanceTo(closestPointOnLine);
                if (distanceToLine <= 1.0) {
                    target.hurt(DamageSource.playerAttack(player), damage);
                    Vec3 knockback = direction.scale(0.5);
                    target.push(knockback.x, 0.1, knockback.z);
                }
            }
        }
    }

    public static void dealLineDamage(ServerPlayer player, ServerLevel level, Vec3 startPos, Vec3 endPos, float damage) {
        AABB damageAABB = new AABB(startPos, endPos).inflate(2.0, 2.0, 2.0);

        List<LivingEntity> targets = level.getEntitiesOfClass(LivingEntity.class, damageAABB, entity ->
