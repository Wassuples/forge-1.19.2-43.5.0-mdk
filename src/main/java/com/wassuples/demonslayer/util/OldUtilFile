        @SubscribeEvent
        public static void onEntityHurt(LivingHurtEvent event)  {
            if (!(event.getEntity() instanceof ServerPlayer player)) {
                return;
            }
            ServerLevel level = player.getLevel();

            if(wind3Players.contains(player.getUUID())) {
                // This form can parry both projectiles and melee attacks
                if(isParryable(event.getSource())) {
                    event.setCanceled(true); // Negate the incoming damage
                    startImmobile(player);   // Trigger the brief "pose" effect

                    // The whirlwind of slashes effect
                    player.swing(InteractionHand.MAIN_HAND);
                    level.playSound(null, player.blockPosition(), SoundEvents.PLAYER_ATTACK_SWEEP, SoundSource.PLAYERS, 1.0f, 1.8f);
                    level.playSound(null, player.blockPosition(), SoundEvents.ENDER_DRAGON_FLAP, SoundSource.PLAYERS, 0.8f, 1.5f);

                    // Spawn a cyclone of particles around the player
                    for(int i = 0; i < 100; i++) {
                        double angle = Math.random() * 2 * Math.PI;
                        double radius = Math.random() * 3.0;
                        double x = player.getX() + Math.cos(angle) * radius;
                        double z = player.getZ() + Math.sin(angle) * radius;
                        double y = player.getY() + Math.random() * 2.5;
                        level.sendParticles(ParticleTypes.SWEEP_ATTACK, x, y, z, 1, 0, 0, 0, 0);
                    }

//                    destroyBlocksInRadius(ServerPlayer player, ServerLevel level, BlockPos center, double horizontalRadius, int verticalRadius, boolean dropBlocks)
                    // The unique effect: Damage the environment instead of entities
                    destroyBlocksInRadius(player, level, player.blockPosition(), 4.0, 1, false);

                    // Knockback the attacker
                    Entity attacker = event.getSource().getDirectEntity();
                    if (attacker instanceof LivingEntity livingAttacker) {
                        double d0 = player.getX() - livingAttacker.getX();
                        double d1 = player.getZ() - livingAttacker.getZ();
                        livingAttacker.knockback(2.5F, d0, d1);
                    }

                    // End the stance
                    wind3Players.remove(player.getUUID());
                }
            }

            if(water11Players.contains(player.getUUID())) {
                if(isParryable(event.getSource())) {
                    event.setCanceled(true);
                    startImmobile(player);
                    level.playSound(null, player.blockPosition(), SoundEvents.ANVIL_PLACE, SoundSource.PLAYERS, 0.5f, 2.0f);
                    level.sendParticles(ParticleTypes.CRIT, player.getX(), player.getEyeY(), player.getZ(), 15, 0.3, 0.3, 0.3, 0.5);
                    level.sendParticles(ParticleTypes.SWEEP_ATTACK, player.getX(), player.getEyeY(), player.getZ(), 1, 0, 0, 0, 0);
                    Entity attacker = event.getSource().getDirectEntity();
                    if (attacker instanceof LivingEntity livingAttacker) {
                        double d0 = player.getX() - livingAttacker.getX();
                        double d1 = player.getZ() - livingAttacker.getZ();
                        livingAttacker.knockback(1.0F, d0, d1);
                    }
                    water11Players.remove(player.getUUID());
                }
            }

            if(flame4Players.contains(player.getUUID())) {
                if(event.getSource().getDirectEntity() instanceof LivingEntity) {
                    event.setCanceled(true);
                    startImmobile(player);
                    player.swing(InteractionHand.MAIN_HAND);
                    level.playSound(null, player.blockPosition(), SoundEvents.GENERIC_EXPLODE, SoundSource.PLAYERS, 1.0f, 1.0f);
                    dealAOEDamage(player, level, 4.0, 10.0f, 0.8f);
                    int particleCount = 60;
                    double radius = 4.0;
                    for (int i = 0; i < particleCount; i++) {
                        double angle = 2 * Math.PI * i / particleCount;
                        double x = player.getX() + radius * Math.cos(angle);
                        double z = player.getZ() + radius * Math.sin(angle);
                        level.sendParticles(ParticleTypes.FLAME, x, player.getY() + 1.0, z, 1, 0, 0, 0, 0.1);
                    }
                    level.sendParticles(ParticleTypes.LAVA, player.getX(), player.getY() + 0.5, player.getZ(), 20, 1.5, 0.5, 1.5, 0);
                    flame4Players.remove(player.getUUID());
                }
            }
        }

