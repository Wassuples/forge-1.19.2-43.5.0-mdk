    /**
     * Contains client-side only logic, such as rendering indicators.
     */
    @OnlyIn(Dist.CLIENT)
    public static class Client {
        public static void handleParryIndicator(Minecraft mc) {
            if (mc.player == null || mc.level == null) return;

            mc.player.getCapability(PlayerStyleProvider.PLAYER_STYLE).ifPresent(style -> {
                BreathingForms currentForm = style.getCurrentForms();
                // Check if the current form is one that has a parry indicator
                if (currentForm != BreathingForms.WATER_11 && currentForm != BreathingForms.FLAME_4 && currentForm != BreathingForms.WIND_3) {
                    return;
                }

                Level level = mc.level;
                AABB scanBox = mc.player.getBoundingBox().inflate(10.0);

                List<Entity> nearbyEntities = level.getEntities(mc.player, scanBox,
                        entity -> !entity.isAlliedTo(mc.player) && (entity instanceof Projectile || entity instanceof LivingEntity));

                for (Entity threat : nearbyEntities) {
                    Vec3 indicatorPos = null;
                    boolean show = false;

                    // --- Case 1: Handle incoming projectiles ---
                    if (threat instanceof Projectile projectile) {
                        Vec3 projectilePos = projectile.position();
                        Vec3 playerPos = mc.player.getEyePosition();
                        double distance = projectilePos.distanceTo(playerPos);
                        Vec3 velocity = projectile.getDeltaMovement();
                        double speed = velocity.length();

                        if (speed > 0.1) {
                            Vec3 toPlayer = playerPos.subtract(projectilePos).normalize();
                            if (velocity.normalize().dot(toPlayer) > 0.9) {
                                double timeToImpact = distance / speed;
                                if (timeToImpact > 2 && timeToImpact < 12) {
                                    indicatorPos = projectile.position();
                                    show = true;
                                }
                            }
                        }
                    }
                    // --- Case 2: Handle melee attacks from Mobs AND Players ---
                    else if (threat instanceof LivingEntity livingThreat) {
                        if (livingThreat.distanceTo(mc.player) < 4.5 && livingThreat.swinging && livingThreat.attackAnim < 6) {
                            indicatorPos = livingThreat.getEyePosition().add(livingThreat.getLookAngle().scale(0.8));
                            show = true;
                        }
                    }

                    if(show && indicatorPos != null) {
                        if (currentForm == BreathingForms.WATER_11) {
                            showWaterIndicator(level, indicatorPos);
                        } else if (currentForm == BreathingForms.FLAME_4) {
                            showFlameIndicator(level, indicatorPos);
                        } else if (currentForm == BreathingForms.WIND_3) {
                            showWindIndicator(level, indicatorPos);
                        }
                    }
                }
            });
        }

        private static void showWaterIndicator(Level level, Vec3 position) {
            level.addParticle(ParticleTypes.END_ROD, position.x, position.y, position.z, 0, 0, 0);
            level.playLocalSound(position.x, position.y, position.z, SoundEvents.NOTE_BLOCK_BELL, SoundSource.PLAYERS, 1.0f, 2.0f, false);
        }

        private static void showFlameIndicator(Level level, Vec3 position) {
            level.addParticle(ParticleTypes.FLAME, position.x, position.y, position.z, 0, 0, 0);
            level.playLocalSound(position.x, position.y, position.z, SoundEvents.FIRE_EXTINGUISH, SoundSource.PLAYERS, 0.6f, 1.8f, false);
        }

        private static void showWindIndicator(Level level, Vec3 position) {
            level.addParticle(ParticleTypes.CLOUD, position.x, position.y, position.z, 0, 0, 0);
            level.playLocalSound(position.x, position.y, position.z, SoundEvents.HORSE_BREATHE, SoundSource.PLAYERS, 1.0f, 2.0f, false);
        }
    }
