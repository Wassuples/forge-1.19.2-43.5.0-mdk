        DustParticleOptions blueDustOptions = new DustParticleOptions(new Vector3f(0.1f, 0.7f, 1.0f), 1.2f);
        for (int i = 0; i < particleCount; i++) {
            double angle = (player.tickCount + i * 18) * 0.1;
            double radius = 1.0 + (activeTicks / 100.0);
            double xOffset = Math.cos(angle) * radius;
            double zOffset = Math.sin(angle) * radius;
            double yOffset = Math.sin((player.tickCount + i * 45) * 0.05) * 0.5 + 1.0;
            level.sendParticles(blueDustOptions, player.getX() + xOffset, player.getY() + yOffset, player.getZ() + zOffset, 1, 0.1f, 0.7f, 1.0f, 1.2f);
            if (activeTicks > 100) {
                level.sendParticles(ParticleTypes.BUBBLE, player.getX() + xOffset, player.getY() + yOffset, player.getZ() + zOffset, 1, 0, 0, 0, 0);
            }
        }
