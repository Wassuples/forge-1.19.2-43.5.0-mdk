    public static void spawnGaleAura(ServerPlayer player, ServerLevel level) {
        int particleCount = 15;
        double radius = 3.5;
        DustParticleOptions whiteDust = new DustParticleOptions(new Vector3f(1.0f, 1.0f, 1.0f), 1.0f);

        for (int i = 0; i < particleCount; i++) {
            // Get a random point on the surface of a sphere
            double theta = 2 * Math.PI * level.random.nextDouble();
            double phi = Math.acos(2 * level.random.nextDouble() - 1);
            double x = player.getX() + radius * Math.sin(phi) * Math.cos(theta);
            double y = player.getY() + player.getBbHeight() / 2.0 + radius * Math.sin(phi) * Math.sin(theta);
            double z = player.getZ() + radius * Math.cos(phi);

            // Add some velocity to make the particles fly outwards
            double vx = (x - player.getX()) * 0.2;
            double vy = (y - (player.getY() + 1.0)) * 0.2;
            double vz = (z - player.getZ()) * 0.2;

            level.sendParticles(whiteDust, x, y, z, 1, vx, vy, vz, 0.1);
            if(i % 5 == 0) { // Add some slashes
                level.sendParticles(ParticleTypes.SWEEP_ATTACK, player.getX(), player.getY() + 1.0, player.getZ(), 1, 0, 0, 0, 0);
            }
        }
    }

    public static void spawnGaleSlashProjectile(ServerLevel level, Vec3 position, Vec3 motion) {
        int particleCount = 25;
        double radius = 1.2;
        DustParticleOptions greenDust = new DustParticleOptions(new Vector3f(0.1f, 0.9f, 0.1f), 0.8f);

        // Get a vector that is perpendicular to the motion direction
        Vec3 perpendicular = motion.cross(new Vec3(0, 1, 0)).normalize();
        if (perpendicular.lengthSqr() == 0) { // Handle case where motion is straight up/down
            perpendicular = new Vec3(1, 0, 0);
        }

        for(int i = 0; i < particleCount; i++) {
            // Create a spinning ring of particles
            double angle = (level.getGameTime() * 0.9) + (i * (2 * Math.PI / particleCount));
            Vec3 offset = perpendicular.scale(Math.cos(angle) * radius).add(motion.cross(perpendicular).normalize().scale(Math.sin(angle) * radius));
            Vec3 particlePos = position.add(offset);
            level.sendParticles(greenDust, particlePos.x, particlePos.y, particlePos.z, 1, 0, 0, 0, 0);

            if(i % 4 == 0) {
                level.sendParticles(ParticleTypes.CLOUD, particlePos.x, particlePos.y, particlePos.z, 1, 0, 0, 0, 0.05);
            }
        }
    }

    public static void executeFallingSlamAttack(ServerPlayer player) {
        ServerLevel level = player.getLevel();
        float fallDistance = Math.min(player.fallDistance, 50.0f);
        float damage = 5.0f + (fallDistance * 0.8f);
        double radius = Math.min(2.0 + (fallDistance * 0.15), 10);
        float knockback = 0.5f + (fallDistance * 0.05f);
        dealAOEDamage(player, level, radius, damage, knockback);
        level.playSound(null, player.blockPosition(), SoundEvents.GENERIC_SPLASH, SoundSource.PLAYERS, 1.0f, 0.8f);
        level.sendParticles(ParticleTypes.EXPLOSION_EMITTER, player.getX(), player.getY(), player.getZ(), 1, 0, 0, 0, 0);
        for (int i = 0; i < 50; i++) {
            level.sendParticles(ParticleTypes.SPLASH, player.getX(), player.getY(), player.getZ(), 1, (Math.random() - 0.5) * radius, 0.5, (Math.random() - 0.5) * radius, 0.5);
        }
        player.fallDistance = 0;
    }

    public static void carveRengokuTrench(ServerPlayer player, Vec3 startPos, Vec3 endPos) {
        ServerLevel level = player.getLevel();
        int segments = (int) startPos.distanceTo(endPos);

        if (segments == 0) return;

        Vec3 direction = endPos.subtract(startPos).normalize();

        for (int i = 0; i < segments; i++) {
            Vec3 currentPoint = startPos.add(direction.scale(i));
            BlockPos centerPos = new BlockPos(currentPoint);

            // Carve a 3x3 area around the center point of the dash path
            for (int x = -1; x <= 1; x++) {
                for (int z = -1; z <= 1; z++) {
                    BlockPos groundPos = level.getHeightmapPos(net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING_NO_LEAVES, centerPos.offset(x, 0, z));

                    // Carve 2 blocks deep
                    BlockPos pos1 = groundPos.below();
                    BlockPos pos2 = groundPos.below(2);

                    // Place magma/netherrack below and set fire above
                    if (!level.getBlockState(pos1).isAir()) {
                        level.setBlock(pos1, Blocks.AIR.defaultBlockState(), 3);
                    }
                    if (!level.getBlockState(pos2).isAir()) {
                        if (level.random.nextFloat() > 0.6f) {
                            level.setBlock(pos2, Blocks.MAGMA_BLOCK.defaultBlockState(), 3);
                        } else {
                            level.setBlock(pos2, Blocks.NETHERRACK.defaultBlockState(), 3);
                        }
                    }

                    // Set fire on top of the new ground
                    BlockPos firePos = pos2.above();
                    if (level.getBlockState(firePos).isAir()) {
                        level.setBlock(firePos, Blocks.FIRE.defaultBlockState(), 3);
                    }
                }
            }
        }
    }

    public static void destroyBlocksInRadius(ServerPlayer player, ServerLevel level, BlockPos center, double horizontalRadius, int verticalRadius, boolean dropBlocks) {
        BlockPos.MutableBlockPos mutablePos = new BlockPos.MutableBlockPos();
        int hRadius = (int) Math.ceil(horizontalRadius);

        for (int x = -hRadius; x <= hRadius; x++) {
            for (int z = -hRadius; z <= hRadius; z++) {
                // ADDED CHECK: Do not destroy the column of blocks directly under the center point (x=0, z=0).
                if (x == 0 && z == 0) {
                    continue;
                }

                if (x * x + z * z <= horizontalRadius * horizontalRadius) {
                    for (int y = -verticalRadius; y <= verticalRadius; y++) {
                        if (level.random.nextFloat() < 0.4f) {
                            mutablePos.set(center.getX() + x, center.getY() + y, center.getZ() + z);
                            if (level.getBlockState(mutablePos).getDestroySpeed(level, mutablePos) >= 0) {
                                level.destroyBlock(mutablePos, dropBlocks, player);
                            }
                        }
                    }
                }
            }
        }
    }

    public static void moveForwardWithSpeed(ServerPlayer player, double speed) {
        Vec3 lookVec = player.getLookAngle();
        Vec3 velocity = new Vec3(lookVec.x * speed, player.getDeltaMovement().y, lookVec.z * speed);
        player.setDeltaMovement(velocity);
        player.hurtMarked = true;
        player.connection.send(new ClientboundSetEntityMotionPacket(player));
    }

