    public static void spawnRisingDustStorm(ServerPlayer player, ServerLevel level, BlockPos stormCenter, int activeTicks) {
        int duration = 80; // 4 seconds
        float progress = (float) activeTicks / duration;
        int particleCount = 20;
        double radius = 4.0;
        double height = 15.0;

        // Brown dust for the ground particles
        DustParticleOptions greenDust = new DustParticleOptions(new Vector3f(0.1f, 0.9f, 0.1f), 1.5f);
        // Grey/white for the wind slashes
        DustParticleOptions wind = new DustParticleOptions(new Vector3f(1.0f, 1.0f, 1.0f), 1.0f);

        for (int i = 0; i < particleCount; i++) {
            // Swirling motion
            double angle = (activeTicks * 0.25) + (i * (2 * Math.PI / particleCount));
            // The vortex gets slightly wider as it rises
            double currentRadius = radius * (0.5 + progress * 0.5);
            double x = stormCenter.getX() + 0.5 + Math.cos(angle) * currentRadius;
            double z = stormCenter.getZ() + 0.5 + Math.sin(angle) * currentRadius;
            // Particles spawn along the height of the cylinder
            double y = stormCenter.getY() + Math.random() * height;

            // Spawn mostly wind particles, with some dust mixed in
            if (i % 3 == 0) {
                level.sendParticles(greenDust, x, y, z, 1, 0, 0, 0, 0);
            } else {
                level.sendParticles(wind, x, y, z, 1, 0, 0, 0, 0);
            }
        }
        // Add sweep attack particles for the "slashes"
        if (activeTicks % 5 == 0) {
            level.sendParticles(ParticleTypes.SWEEP_ATTACK, stormCenter.getX() + 0.5, stormCenter.getY() + (Math.random() * height), stormCenter.getZ() + 0.5, 3, radius, 0.1, radius, 0);
        }
    }

